# Local dev uses SQLite; docker-compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite:///./metacritic.db
POSTGRES_PASSWORD=metacritic

# Crawler
SCHEDULER_ENABLED=true
# set on public deployments: starting a crawl by hand then needs this token
ADMIN_TOKEN=
CRAWL_INTERVAL_MINUTES=60
GAMES_PER_RUN=20
MAX_PAGES_PER_RUN=10
REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
MAX_BACKOFF_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# LLM for review summaries and embeddings: any OpenAI-compatible API.
# Leave LLM_BASE_URL unset to use Ollama: http://localhost:11434/v1 for `make run`, the ollama
# compose service in Docker (docker compose --profile ollama up).
# Host's Ollama from Docker: LLM_BASE_URL=http://host.docker.internal:11434/v1
# Hosted API, e.g. OpenRouter for both chat and embeddings:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=<key>
#   LLM_MODEL=google/gemma-3-4b-it
#   EMBED_MODEL=openai/text-embedding-3-small
# LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma3:4b
# similar games; any model served at LLM_BASE_URL/embeddings (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
# summary calls per UTC day across all runs; past it summaries wait for the next day
LLM_DAILY_CALL_LIMIT=400
