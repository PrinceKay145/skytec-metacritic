# Local dev uses SQLite; docker-compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite:///./metacritic.db
POSTGRES_PASSWORD=metacritic

# Crawler
SCHEDULER_ENABLED=true
CRAWL_INTERVAL_MINUTES=60
GAMES_PER_RUN=20
MAX_PAGES_PER_RUN=10
REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
MAX_BACKOFF_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# LLM for review summaries: any OpenAI-compatible chat API.
# Local Ollama by default; from Docker use http://host.docker.internal:11434/v1.
# Hosted example: LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=<key>, LLM_MODEL=<model id>
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
